{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "github": {
    "silent": true
  },
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/{@mathjax/mathjax-newcm-font,mhchemparser,ip2region/data}/**/*"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": ["sin1"]
}
